{"content":"#!/usr/bin/env python3\n\"\"\"Script to verify the self-signed TLS certificate.\"\"\"\n\nimport os\nimport sys\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\n\ndef check_cert_exists():\n    \"\"\"Verify that the certificate file exists.\"\"\"\n    if not os.path.exists(CERT_PATH):\n        print(f\"ERROR: Certificate file not found at {CERT_PATH}\")\n        return False\n    print(f\"Certificate file found: {CERT_PATH}\")\n    return True\n\n\ndef load_certificate():\n    \"\"\"Load the certificate using OpenSSL via subprocess.\"\"\"\n    import subprocess\n\n    try:\n        result = subprocess.run(\n            [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-text\"],\n            capture_output=True,\n            text=True,\n            check=True,\n        )\n        return result.stdout\n    except subprocess.CalledProcessError as e:\n        print(f\"ERROR: Failed to load certificate: {e.stderr}\")\n        return None\n\n\ndef extract_field(cert_text, field_name):\n    \"\"\"Extract a field value from the certificate text output.\"\"\"\n    for line in cert_text.splitlines():\n        if field_name in line:\n            return line.split(\":\", 1)[1].strip()\n    return None\n\n\ndef get_common_name(cert_text):\n    \"\"\"Extract the Common Name from the certificate.\"\"\"\n    for line in cert_text.splitlines():\n        if \"Subject:\" in line:\n            # Parse the Subject line for CN\n            parts = line.split(\"Subject:\")[1].strip()\n            for part in parts.split(\"/\"):\n                if part.strip().startswith(\"CN\"):\n                    return part.split(\"=\", 1)[1].strip()\n    return None\n\n\ndef get_expiration_date(cert_text):\n    \"\"\"Extract and format the expiration date as YYYY-MM-DD.\"\"\"\n    for line in cert_text.splitlines():\n        if \"Not After\" in line:\n            date_str = line.split(\"Not After\")[1].strip()\n            # Parse the date string (e.g., \"Aug 11 00:32:20 2027 GMT\")\n            dt = datetime.strptime(date_str, \"%b %d %H:%M:%S %Y %Z\")\n            return dt.strftime(\"%Y-%m-%d\")\n    return None\n\n\ndef main():\n    # Step 1: Verify certificate exists\n    if not check_cert_exists():\n        sys.exit(1)\n\n    # Step 2: Load the certificate\n    cert_text = load_certificate()\n    if cert_text is None:\n        print(\"ERROR: Could not load certificate.\")\n        sys.exit(1)\n\n    print(\"Certificate loaded successfully.\")\n\n    # Step 3: Extract and print certificate details\n    common_name = get_common_name(cert_text)\n    expiration_date = get_expiration_date(cert_text)\n\n    if common_name:\n        print(f\"Common Name: {common_name}\")\n    else:\n        print(\"WARNING: Could not extract Common Name.\")\n\n    if expiration_date:\n        print(f\"Expiration Date: {expiration_date}\")\n    else:\n        print(\"WARNING: Could not extract expiration date.\")\n\n    # Step 4: Verify the certificate is valid (not expired)\n    if expiration_date:\n        exp_date = datetime.strptime(expiration_date, \"%Y-%m-%d\")\n        if exp_date < datetime.now():\n            print(\"ERROR: Certificate has expired.\")\n            sys.exit(1)\n\n    print(\"Certificate verification successful\")\n\n\nif __name__ == \"__main__\":\n    main()\n","path":"/app/check_cert.py"}
