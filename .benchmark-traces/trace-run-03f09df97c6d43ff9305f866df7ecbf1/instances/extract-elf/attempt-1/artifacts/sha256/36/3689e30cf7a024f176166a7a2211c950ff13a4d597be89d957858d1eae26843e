const fs = require('fs');

if (process.argv.length < 3) {
    process.stderr.write('Usage: node extract.js <elffile>\n');
    process.exit(1);
}

const filename = process.argv[2];
const buf = fs.readFileSync(filename);

// Parse ELF header
// ELF magic
if (buf[0] !== 0x7f || buf[1] !== 0x45 || buf[2] !== 0x4c || buf[3] !== 0x46) {
    process.stderr.write('Not an ELF file\n');
    process.exit(1);
}

const is64 = buf[4] === 2;  // ELFCLASS64
const isLittleEndian = buf[5] === 1;  // ELFDATA2LSB

if (!is64 || !isLittleEndian) {
    process.stderr.write('Only 64-bit little-endian ELF supported\n');
    process.exit(1);
}

// Read program headers
const phoff = buf.readBigUInt64LE(32);  // e_phoff
const phnum = buf.readUInt16LE(52);      // e_phnum
const phentsize = buf.readUInt16LE(54);  // e_phentsize
const phdrStart = Number(phoff);

// Collect memory segments
const segments = [];
for (let i = 0; i < phnum; i++) {
    const off = phdrStart + i * phentsize;
    const p_type = buf.readUInt32LE(off);
    const p_flags = buf.readUInt32LE(off + 4);
    const p_offset = Number(buf.readBigUInt64LE(off + 8));
    const p_vaddr = Number(buf.readBigUInt64LE(off + 16));
    const p_filesz = Number(buf.readBigUInt64LE(off + 32));
    const p_memsz = Number(buf.readBigUInt64LE(off + 40));

    // PT_LOAD = 1
    if (p_type === 1) {
        segments.push({
            type: 'LOAD',
            offset: p_offset,
            vaddr: p_vaddr,
            filesz: p_filesz,
            memsz: p_memsz,
            flags: p_flags,
        });
    }
}

// Build a map of virtual address -> file offset for loadable segments
const vaddrMap = [];
for (const seg of segments) {
    vaddrMap.push({
        start: seg.vaddr,
        end: seg.vaddr + seg.memsz,
        fileStart: seg.offset,
        fileEnd: seg.offset + seg.filesz,
        flags: seg.flags,
    });
}

function vaddrToFileOffset(vaddr) {
    for (const vm of vaddrMap) {
        if (vaddr >= vm.start && vaddr < vm.end) {
            const fileOff = vm.fileStart + (vaddr - vm.start);
            if (fileOff < vm.fileEnd) {
                return fileOff;
            }
            return null;  // Part of BSS (no file content)
        }
    }
    return null;
}

// Parse section headers
const shoff = Number(buf.readBigUInt64LE(40));  // e_shoff
const shentsize = buf.readUInt16LE(58);         // e_shentsize
const shnum = buf.readUInt16LE(60);             // e_shnum
const shstrndx = buf.readUInt16LE(62);          // e_shstrndx

// Read section header string table
const shstrOff = shoff + shstrndx * shentsize;
const shstrSectionOffset = Number(buf.readBigUInt64LE(shstrOff + 24));
const shstrSectionSize = Number(buf.readBigUInt64LE(shstrOff + 32));

function getSectionName(nameOffset) {
    let end = shstrSectionOffset + nameOffset;
    while (end < buf.length && buf[end] !== 0) {
        end++;
    }
    return buf.slice(shstrSectionOffset, end).toString('ascii');
}

// Collect section info
const sections = [];
for (let i = 0; i < shnum; i++) {
    const off = shoff + i * shentsize;
    const s_name = buf.readUInt32LE(off);
    const s_type = buf.readUInt32LE(off + 4);
    const s_flags = Number(buf.readBigUInt64LE(off + 8));
    const s_addr = Number(buf.readBigUInt64LE(off + 16));
    const s_offset = Number(buf.readBigUInt64LE(off + 24));
    const s_size = Number(buf.readBigUInt64LE(off + 32));
    
    const name = getSectionName(s_name);
    
    // SHT_PROGBITS = 1, SHT_NOBITS = 8
    // We want data sections - PROGBITS with ALLOC flag
    // Check for writable sections (contains data we can read)
    if (s_type === 1 && s_flags & 0x2) {  // SHF_ALLOC and SHF_WRITE
        sections.push({
            name: name,
            addr: s_addr,
            offset: s_offset,
            size: s_size,
            flags: s_flags,
        });
    }
}

// Extract 8-byte values from each section
const result = {};

for (const sec of sections) {
    const startAddr = sec.addr;
    const dataOffset = sec.offset;
    const dataSize = sec.size;
    
    // Read 8-byte little-endian values
    for (let i = 0; i + 8 <= dataSize; i += 8) {
        const addr = startAddr + i;
        const fileOff = dataOffset + i;
        const val = Number(buf.readBigUInt64LE(fileOff));
        result[addr.toString()] = val;
    }
}

// Also extract 4-byte values from read-only data sections
// Parse section headers again for read-only data
for (let i = 0; i < shnum; i++) {
    const off = shoff + i * shentsize;
    const s_name = buf.readUInt32LE(off);
    const s_type = buf.readUInt32LE(off + 4);
    const s_flags = Number(buf.readBigUInt64LE(off + 8));
    const s_addr = Number(buf.readBigUInt64LE(off + 16));
    const s_offset = Number(buf.readBigUInt64LE(off + 24));
    const s_size = Number(buf.readBigUInt64LE(off + 32));
    
    const name = getSectionName(s_name);
    
    // Also check read-only data sections (rodata, etc.)
    if (s_type === 1 && s_flags & 0x2 && !(s_flags & 0x4)) {  // SHF_ALLOC but not SHF_EXECINSTR
        // Only if we haven't already covered it
        if (name !== '.init_array' && name !== '.fini_array' && name !== '.dynamic' && name !== '.got' && name !== '.data') {
            for (let i = 0; i + 8 <= s_size; i += 8) {
                const addr = s_addr + i;
                // Check if already in result
                if (!(addr.toString() in result)) {
                    const fileOff = s_offset + i;
                    const val = Number(buf.readBigUInt64LE(fileOff));
                    result[addr.toString()] = val;
                }
            }
        }
    }
}

process.stdout.write(JSON.stringify(result) + '\n');
