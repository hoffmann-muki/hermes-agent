{"content":"#!/usr/bin/env python3\n\"\"\"TLS Certificate Verification Script\"\"\"\n\nimport subprocess\nimport sys\nfrom datetime import datetime\n\n\ndef verify_certificate(cert_path: str = \"/app/ssl/server.crt\") -> bool:\n    \"\"\"Verify the certificate details and return True if valid.\"\"\"\n    try:\n        # Verify certificate exists and is readable\n        with open(cert_path, \"r\") as f:\n            cert_content = f.read()\n\n        if not cert_content.startswith(\"-----BEGIN CERTIFICATE-----\"):\n            print(\"ERROR: Certificate file is not valid\")\n            return False\n\n        # Extract and verify certificate details using openssl\n        result = subprocess.run(\n            [\"openssl\", \"x509\", \"-in\", cert_path, \"-noout\", \"-subject\", \"-dates\"],\n            capture_output=True,\n            text=True\n        )\n\n        if result.returncode != 0:\n            print(f\"ERROR: Certificate verification failed: {result.stderr}\")\n            return False\n\n        print(\"Certificate Details:\")\n        print(result.stdout)\n\n        # Verify the certificate is not expired\n        verify_result = subprocess.run(\n            [\"openssl\", \"x509\", \"-in\", cert_path, \"-noout\", \"-checkend\", \"0\"],\n            capture_output=True,\n            text=True\n        )\n\n        if verify_result.returncode == 0:\n            print(\"Status: Certificate is valid and not expired\")\n        else:\n            print(\"Status: Certificate has expired or is invalid\")\n            return False\n\n        return True\n\n    except FileNotFoundError:\n        print(f\"ERROR: Certificate file not found: {cert_path}\")\n        return False\n    except Exception as e:\n        print(f\"ERROR: Unexpected error: {e}\")\n        return False\n\n\ndef main():\n    print(\"=\" * 50)\n    print(\"TLS Certificate Verification\")\n    print(\"=\" * 50)\n\n    if verify_certificate():\n        print(\"\\nVerification PASSED\")\n        sys.exit(0)\n    else:\n        print(\"\\nVerification FAILED\")\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\n","path":"/app/check_cert.py"}
