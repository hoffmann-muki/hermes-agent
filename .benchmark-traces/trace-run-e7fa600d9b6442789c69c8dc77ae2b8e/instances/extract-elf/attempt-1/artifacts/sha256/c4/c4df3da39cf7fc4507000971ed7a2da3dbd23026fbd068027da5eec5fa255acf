{"content":"const fs = require('fs');\n\nfunction analyzeBinary(filePath) {\n    const buffer = fs.readFileSync(filePath);\n    \n    // Parse ELF header\n    const e_ident = buffer.slice(0, 16);\n    const is64Bit = e_ident[4] === 2;\n    \n    let offset = 16;\n    let e_type, e_machine, e_version;\n    let e_entry, e_phoff, e_shoff;\n    let e_flags, e_ehsize, e_phentsize, e_phnum;\n    let e_shentsize, e_shnum, e_shstrndx;\n    \n    if (is64Bit) {\n        e_type = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_machine = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_version = buffer.readUInt32LE(offset);\n        offset += 4;\n        e_entry = buffer.readBigUInt64LE(offset);\n        offset += 8;\n        e_phoff = buffer.readBigUInt64LE(offset);\n        offset += 8;\n        e_shoff = buffer.readBigUInt64LE(offset);\n        offset += 8;\n        e_flags = buffer.readUInt32LE(offset);\n        offset += 4;\n        e_ehsize = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_phentsize = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_phnum = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_shentsize = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_shnum = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_shstrndx = buffer.readUInt16LE(offset);\n    } else {\n        e_type = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_machine = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_version = buffer.readUInt32LE(offset);\n        offset += 4;\n        e_entry = buffer.readUInt32LE(offset);\n        offset += 4;\n        e_phoff = buffer.readUInt32LE(offset);\n        offset += 4;\n        e_shoff = buffer.readUInt32LE(offset);\n        offset += 4;\n        e_flags = buffer.readUInt32LE(offset);\n        offset += 4;\n        e_ehsize = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_phentsize = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_phnum = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_shentsize = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_shnum = buffer.readUInt16LE(offset);\n        offset += 2;\n        e_shstrndx = buffer.readUInt16LE(offset);\n    }\n    \n    console.log('ELF Header:');\n    console.log('  is64Bit:', is64Bit);\n    console.log('  e_shoff:', e_shoff);\n    console.log('  e_shnum:', e_shnum);\n    console.log('  e_shstrndx:', e_shstrndx);\n    \n    // Read section headers\n    const sections = [];\n    const sectionHeaderSize = is64Bit ? 64 : 40;\n    \n    for (let i = 0; i < e_shnum; i++) {\n        const shOffset = Number(e_shoff) + i * sectionHeaderSize;\n        let sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size;\n        let sh_link, sh_info, sh_addralign, sh_entsize;\n        \n        if (is64Bit) {\n            sh_name = buffer.readUInt32LE(shOffset);\n            sh_type = buffer.readUInt32LE(shOffset + 4);\n            sh_flags = buffer.readBigUInt64LE(shOffset + 8);\n            sh_addr = buffer.readBigUInt64LE(shOffset + 16);\n            sh_offset = buffer.readBigUInt64LE(shOffset + 24);\n            sh_size = buffer.readBigUInt64LE(shOffset + 32);\n            sh_link = buffer.readUInt32LE(shOffset + 40);\n            sh_info = buffer.readUInt32LE(shOffset + 44);\n            sh_addralign = buffer.readBigUInt64LE(shOffset + 48);\n            sh_entsize = buffer.readBigUInt64LE(shOffset + 56);\n        } else {\n            sh_name = buffer.readUInt32LE(shOffset);\n            sh_type = buffer.readUInt32LE(shOffset + 4);\n            sh_flags = buffer.readUInt32LE(shOffset + 8);\n            sh_addr = buffer.readUInt32LE(shOffset + 12);\n            sh_offset = buffer.readUInt32LE(shOffset + 16);\n            sh_size = buffer.readUInt32LE(shOffset + 20);\n            sh_link = buffer.readUInt32LE(shOffset + 24);\n            sh_info = buffer.readUInt32LE(shOffset + 28);\n            sh_addralign = buffer.readUInt32LE(shOffset + 32);\n            sh_entsize = buffer.readUInt32LE(shOffset + 36);\n        }\n        \n        sections.push({\n            name: sh_name,\n            type: sh_type,\n            flags: sh_flags,\n            addr: sh_addr,\n            offset: sh_offset,\n            size: sh_size,\n            link: sh_link,\n            info: sh_info,\n            addralign: sh_addralign,\n            entsize: sh_entsize\n        });\n    }\n    \n    // Get section header string table\n    const shstrtabSection = sections[e_shstrndx];\n    const shstrtab = buffer.slice(Number(shstrtabSection.offset), Number(shstrtabSection.offset) + Number(shstrtabSection.size));\n    \n    // Get section names\n    for (const section of sections) {\n        let name = '';\n        let strOffset = section.name;\n        while (strOffset < shstrtab.length && shstrtab[strOffset] !== 0) {\n            name += String.fromCharCode(shstrtab[strOffset]);\n            strOffset++;\n        }\n        section.name = name;\n    }\n    \n    console.log('\\nSections:');\n    for (const section of sections) {\n        console.log(`  ${section.name}: type=${section.type}, addr=${section.addr}, offset=${section.offset}, size=${section.size}`);\n    }\n}\n\nconst filePath = process.argv[2];\nif (!filePath) {\n    console.error('Usage: node analyze.js <binary_file>');\n    process.exit(1);\n}\n\nanalyzeBinary(filePath);\n","path":"/app/analyze.js"}
